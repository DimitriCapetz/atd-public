interface Ethernet3
   shutdown

interface Ethernet5
   switchport
   switchport mode trunk
   switchport trunk allowed vlan 99
!
vlan 99
   name VLAN99
!
vrf instance VLAN99
!
ip routing vrf VLAN99
!
interface Vlan99
   description VLAN99 BGP Handoff
   vrf VLAN99
   ip address 10.99.3.1/30
!
router bgp 65003
   vrf VLAN99
      neighbor 10.99.3.2 remote-as 65018
