vrf instance VLAN100
!
ip routing vrf VLAN100
!
vlan 100
   name VLAN100
!
interface Ethernet1
   description CORE
   switchport
   switchport mode trunk
   switchport trunk allowed vlan 100,102
!
interface Vlan100
   description VLAN100 Client Interface
   vrf VLAN100
   ip address 10.100.100.15/24

vrf instance VLAN102
!
ip routing vrf VLAN102
!
ip route vrf VLAN102 0.0.0.0/0 10.102.102.1
!
vlan 102
   name VLAN102
!
interface Vlan102
   description VLAN102 Client Interface
   vrf VLAN102
   ip address 10.102.102.15/24
